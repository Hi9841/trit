---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Cmd from "../components/Cmd.astro";
import Race from "../components/Race.astro";
import Stats from "../components/Stats.astro";
import Footer from "../components/Footer.astro";
import { links } from "../lib/links";
import { megabytes, redux } from "../lib/data";
import { stat, tagline, whatIs } from "../lib/facts";
import { updatedOf } from "../lib/repo";
import { crank, suitcase } from "../lib/sketch";

const updated = updatedOf([
  "trit/site/src/pages/index.astro",
  "trit/site/src/lib/facts.ts",
  "desktop/bench/benchmarks.json",
  "trit/src/catalog.rs",
]);
---

<Base
  title={`Trit · ${tagline}`}
  description={whatIs}
  updated={updated}
>
  <Header />
  <main>
    <section class="grid hero">
      <div class="words">
        <p class="label">Speech-to-text engine · Rust · CPU only</p>
        <h1 class="display xl">
          <span class="line">Speech in,</span><span class="line">text out,</span><span class="line"
            >no GPU.</span
          >
        </h1>
        <p class="lead">{whatIs}</p>
        <Cmd command="trit transcribe take.wav" />
        <div class="more">
          <a href={links.docs}>Read the docs</a>
          <a href={links.benchmarks}>See the benchmarks</a>
        </div>
      </div>
      <figure class="art draw" data-scene="crank"><Fragment set:html={crank} /></figure>
    </section>

    <section class="grid proof">
      <div class="intro">
        <p class="label">Same model · three runtimes</p>
        <h2 class="display l">
          <span class="line">Done before</span><span class="line">you blink.</span>
        </h2>
        <p class="lead">
          Each bar is one runtime turning a clip into text with the same Parakeet Redux weights.
        </p>
      </div>
      <Race />
      <p class="stat">
        {stat.text} <a href={links.benchmarks}>The results</a>, {stat.date}.
      </p>
    </section>

    <section class="grid pack">
      <figure class="art" data-scene="suitcase">
        <Fragment set:html={suitcase} />
        <figcaption>
          Same weights, two suitcases. After all the test clips, Transformers holds {
            megabytes(redux.transformers.run_mb)
          } of memory and Trit {megabytes(redux.trit.run_mb)}.
        </figcaption>
      </figure>
      <div class="numbers"><Stats /></div>
    </section>
  </main>
  <Footer updated={updated} />
</Base>

<script>
  // The crank drawing draws itself once, after the handwriting font is ready;
  // its story (motion.ts) starts as the draw-in ends.
  document.fonts.ready.then(() => {
    for (const art of document.querySelectorAll(".art.draw")) {
      requestAnimationFrame(() => art.classList.add("go"));
    }
  });
</script>

<style>
  /* Two columns of equal weight, centred on the same axis: the words on
     five, the drawing on seven (its own margin keeps them apart). */
  .hero {
    align-items: center;
    padding-top: 72px;
  }
  .words {
    grid-column: 1 / span 5;
  }
  .hero .label {
    margin-bottom: 28px;
  }
  .hero h1 {
    font-size: clamp(3rem, 6.6vw, 6.5rem);
    line-height: 0.94;
    letter-spacing: -0.05em;
  }
  .hero .lead {
    max-width: 34ch;
    margin: 36px 0 0;
    font-size: 19px;
    line-height: 1.55;
    color: var(--muted);
  }
  .words :global(.cmd) {
    max-width: 400px;
    margin-top: 32px;
  }
  .more {
    display: flex;
    gap: 24px;
    margin-top: 20px;
    font-size: 15px;
  }
  .more a {
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 4px;
    transition: text-decoration-color 150ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .more a:hover {
      text-decoration-color: var(--ink);
    }
  }
  .hero .art {
    grid-column: 6 / -1;
  }

  .proof {
    margin-top: 192px;
    align-items: start;
  }
  .intro {
    grid-column: 1 / span 5;
  }
  .intro .label {
    margin-bottom: 24px;
  }
  .intro .lead {
    margin: 32px 0 0;
  }
  .proof :global(.race) {
    grid-column: 7 / -1;
  }
  /* The benchmark's finding, in a sentence that can be quoted. */
  .stat {
    grid-column: 7 / -1;
    max-width: var(--measure);
    margin: 32px 0 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
  }
  .stat a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 4px;
  }

  .pack {
    margin-top: 160px;
    align-items: center;
  }
  .pack .art {
    grid-column: 1 / span 7;
  }
  .numbers {
    grid-column: 9 / -1;
  }

  @media (max-width: 900px) {
    .words,
    .hero .art,
    .intro,
    .proof :global(.race),
    .stat,
    .pack .art,
    .numbers {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .hero {
      padding-top: 48px;
    }
    .hero .art {
      margin-top: 56px;
    }
    .proof :global(.race),
    .numbers {
      margin-top: 64px;
    }
  }
  @media (max-width: 600px) {
    .proof {
      margin-top: 128px;
    }
  }
</style>
