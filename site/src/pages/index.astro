---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Cmd from "../components/Cmd.astro";
import Race from "../components/Race.astro";
import Stats from "../components/Stats.astro";
import Footer from "../components/Footer.astro";
import { links } from "../lib/links";
import { megabytes, redux } from "../lib/data";
import { crank, suitcase } from "../lib/sketch";
---

<Base
  title="Trit · speech to text on the CPU"
  description="Trit runs Parakeet, Whisper, Canary and Moonshine checkpoints from Hugging Face on its own CPU kernels. No GPU, no Python, no PyTorch."
>
  <Header />
  <main>
    <section class="grid hero">
      <p class="label">Speech-to-text engine · Rust · CPU only</p>
      <h1 class="display xl">
        <span class="line">Speech in,</span><span class="line">text out,</span><span class="line"
          >no GPU.</span
        >
      </h1>
      <div class="side">
        <p class="lead">
          Trit runs Parakeet, Whisper, Canary and Moonshine checkpoints straight from Hugging Face,
          on its own kernels. No Python, no PyTorch, no ONNX Runtime.
        </p>
        <Cmd command="trit transcribe take.wav" />
        <div class="more">
          <a href={links.docs}>Read the docs</a>
          <a href={links.benchmarks}>See the benchmarks</a>
        </div>
      </div>
      <figure class="art draw" data-act="crank"><Fragment set:html={crank} /></figure>
    </section>

    <section class="grid proof">
      <div class="intro">
        <p class="label">Same model · three runtimes</p>
        <h2 class="display l">
          <span class="line">Done before</span><span class="line">you blink.</span>
        </h2>
        <p class="lead">
          Each bar is one runtime turning a clip into text with the same Parakeet Redux weights.
        </p>
      </div>
      <Race />
    </section>

    <section class="grid pack">
      <figure class="art" data-act="walk">
        <Fragment set:html={suitcase} />
        <figcaption>
          Same weights, two suitcases. After all the test clips, Transformers holds {
            megabytes(redux.transformers.run_mb)
          } of memory and Trit {megabytes(redux.trit.run_mb)}.
        </figcaption>
      </figure>
      <div class="numbers"><Stats /></div>
    </section>
  </main>
  <Footer />
</Base>

<script>
  // The crank drawing draws itself once, after the handwriting font is ready.
  document.fonts.ready.then(() => {
    for (const art of document.querySelectorAll(".art.draw")) {
      requestAnimationFrame(() => art.classList.add("go"));
    }
  });
</script>

<style>
  .hero {
    padding-top: 64px;
  }
  .hero .label {
    grid-column: 1 / span 6;
    grid-row: 1;
    margin-bottom: 24px;
  }
  .hero h1 {
    grid-column: 1 / span 5;
    grid-row: 2;
  }
  .side {
    grid-column: 1 / span 4;
    grid-row: 3;
    margin-top: 56px;
  }
  .more {
    display: flex;
    gap: 24px;
    margin-top: 16px;
    font-size: 15px;
  }
  .more a {
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 4px;
    transition: text-decoration-color 150ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .more a:hover {
      text-decoration-color: var(--ink);
    }
  }
  /* The one break from the grid: the drawing runs off the right edge. */
  .hero .art {
    grid-column: 6 / -1;
    grid-row: 1 / span 3;
    align-self: center;
    margin-right: calc(var(--margin) * -1);
  }

  .proof {
    margin-top: 192px;
    align-items: start;
  }
  .intro {
    grid-column: 1 / span 5;
  }
  .intro .label {
    margin-bottom: 24px;
  }
  .intro .lead {
    margin: 32px 0 0;
  }
  .proof :global(.race) {
    grid-column: 7 / -1;
  }

  .pack {
    margin-top: 160px;
    align-items: center;
  }
  .pack .art {
    grid-column: 1 / span 7;
  }
  .numbers {
    grid-column: 9 / -1;
  }

  @media (max-width: 900px) {
    .hero .label,
    .hero h1,
    .side,
    .hero .art,
    .intro,
    .proof :global(.race),
    .pack .art,
    .numbers {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .side {
      margin-top: 48px;
    }
    .hero .art {
      margin-top: 48px;
      margin-right: 0;
    }
    .proof :global(.race),
    .numbers {
      margin-top: 64px;
    }
  }
  @media (max-width: 600px) {
    .proof {
      margin-top: 128px;
    }
  }
</style>
