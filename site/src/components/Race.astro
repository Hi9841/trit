---
// The race on one time axis, against a human scale: a blink takes 100 to
// 400 ms (the band). Each bar grows for its runtime's median time per clip,
// 10x slower. Parakeet Redux, 200 LibriSpeech test-clean clips, Ryzen 9
// 7950X3D (desktop/bench/benchmarks.json).
import { redux } from "../lib/data";

const BLINK = [100, 400];

const lanes = [
  { who: "Trit", how: "ternary + f16", ms: Math.round(redux.trit.ms), trit: true },
  { who: "Photon", how: "PyTorch", ms: Math.round(redux.photon.ms), trit: false },
  { who: "Transformers", how: "PyTorch, fp32", ms: Math.round(redux.transformers.ms), trit: false },
];

// The axis ends at the blink's end, or past the slowest runtime, in 100s.
const AXIS = Math.max(BLINK[1]!, Math.ceil(Math.max(...lanes.map((l) => l.ms)) / 100) * 100);
const pct = (ms: number) => `${(100 * ms) / AXIS}%`;
const ticks = Array.from({ length: AXIS / 100 + 1 }, (_, i) => i * 100);
---

<section class="race" aria-label="Runtime race against a blink">
  <div class="head">
    <div class="clock">0<small>ms</small></div>
    <button class="run" type="button">Run</button>
  </div>
  <div class="chart" style={`--b0:${BLINK[0]! / AXIS};--b1:${BLINK[1]! / AXIS}`}>
    <div class="band" aria-hidden="true"><span>A blink, {BLINK[0]}–{BLINK[1]} ms</span></div>
    {
      lanes.map((l) => (
        <div class:list={["lane", { trit: l.trit }]} data-ms={l.ms}>
          <div class="who">
            {l.who}
            <span>{l.how}</span>
          </div>
          <div class="track">
            <div class="bar" style={`width:${pct(l.ms)}`} />
            <span class="t" style={`left:${pct(l.ms)}`}>
              {l.ms} ms
            </span>
          </div>
        </div>
      ))
    }
    <div class="ticks" aria-hidden="true">
      {ticks.map((ms) => <span style={`left:${pct(ms)}`}>{ms}</span>)}
    </div>
  </div>
  <p class="note">
    Parakeet Redux, median of 200 LibriSpeech clips, Ryzen 9 7950X3D. Played 10× slower. Blink duration: 100–400 ms.
  </p>
</section>

<script>
  const SLOW = 10;

  for (const box of document.querySelectorAll<HTMLElement>(".race")) {
    const lanes = [...box.querySelectorAll<HTMLElement>(".lane")];
    const clock = box.querySelector(".clock")!.firstChild!;
    const run = box.querySelector<HTMLButtonElement>(".run")!;
    const max = Math.max(...lanes.map((l) => Number(l.dataset.ms)));
    let timers: number[] = [];
    let frame = 0;

    const bar = (l: HTMLElement) => l.querySelector<HTMLElement>(".bar")!;

    const start = () => {
      timers.forEach(clearTimeout);
      timers = [];
      cancelAnimationFrame(frame);
      run.textContent = "Run again";

      if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
        for (const l of lanes) l.classList.add("done");
        clock.nodeValue = String(max);

        return;
      }

      for (const l of lanes) {
        l.classList.remove("done");
        bar(l).style.transition = "none";
        bar(l).style.transform = "scaleX(0)";
      }

      clock.nodeValue = "0";
      box.getBoundingClientRect(); // commit the reset before the run

      const t0 = performance.now();

      for (const l of lanes) {
        const ms = Number(l.dataset.ms);

        bar(l).style.transition = `transform ${ms * SLOW}ms linear`;
        bar(l).style.transform = "scaleX(1)";
        timers.push(window.setTimeout(() => l.classList.add("done"), ms * SLOW));
      }

      const tick = (now: number) => {
        const elapsed = Math.min(Math.max(0, now - t0) / SLOW, max);

        clock.nodeValue = String(Math.round(elapsed));

        if (elapsed < max) frame = requestAnimationFrame(tick);
      };

      frame = requestAnimationFrame(tick);
    };

    run.addEventListener("click", start);

    // The first run starts when the race is in view, not before.
    const watcher = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        watcher.disconnect();
        timers.push(window.setTimeout(start, 300));
      },
      { threshold: 0.35 },
    );

    watcher.observe(box);
  }
</script>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    margin-bottom: 24px;
  }
  .clock {
    font-family: var(--mono);
    font-size: 64px;
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }
  .clock small {
    margin-left: 8px;
    font-size: 18px;
    letter-spacing: 0;
    color: var(--muted);
  }
  :global(html:not(.js)) .head {
    display: none;
  }
  .run {
    padding: 15px 18px;
    border: 1px solid var(--ink);
    border-radius: 2px;
    background: none;
    color: var(--ink);
    font: 500 14px/1 var(--sans);
    cursor: pointer;
    transition:
      transform 160ms var(--ease-out),
      background-color 150ms ease,
      color 150ms ease;
  }
  .run:active {
    transform: scale(0.97);
  }
  @media (hover: hover) and (pointer: fine) {
    .run:hover {
      background: var(--ink);
      color: var(--paper);
    }
  }

  /* The names on the left; the tracks share one axis on the right, and the
     blink band runs behind all of them. */
  .chart {
    --names: 128px;
    position: relative;
    padding-top: 32px;
  }
  .band {
    position: absolute;
    top: 0;
    bottom: 24px;
    /* --b0 and --b1: where the blink starts and ends, as shares of the axis. */
    left: calc(var(--names) + (100% - var(--names)) * var(--b0));
    right: calc((100% - var(--names)) * (1 - var(--b1)));
    background: var(--tint);
    border-left: 1px dashed var(--rule);
  }
  .band span {
    position: absolute;
    top: 8px;
    left: 8px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .lane {
    position: relative;
    display: grid;
    grid-template-columns: var(--names) 1fr;
    align-items: center;
    height: 56px;
    border-top: 1px solid var(--rule);
  }
  .who {
    font-size: 16px;
    font-weight: 500;
    line-height: 1.2;
  }
  .who span {
    display: block;
    font-size: 13px;
    font-weight: 400;
    color: var(--muted);
  }
  .track {
    position: relative;
    height: 100%;
  }
  .bar {
    position: absolute;
    top: 50%;
    left: 0;
    height: 10px;
    margin-top: -5px;
    background: var(--ink);
    transform-origin: left center;
  }
  .trit .bar {
    background: var(--accent);
  }
  :global(html.js) .bar {
    transform: scaleX(0);
  }
  .t {
    position: absolute;
    top: 50%;
    margin: -10px 0 0 10px;
    font-family: var(--mono);
    font-size: 14px;
    line-height: 20px;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    transition: opacity 150ms ease;
  }
  .trit .t {
    color: var(--accent-text);
  }
  :global(html.js) .lane:not(.done) .t {
    opacity: 0;
  }
  .ticks {
    position: relative;
    height: 24px;
    margin-left: var(--names);
    border-top: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
  }
  .ticks span {
    position: absolute;
    top: 6px;
    transform: translateX(-50%);
  }
  .ticks span:first-child {
    transform: none;
  }
  .ticks span:last-child {
    transform: translateX(-100%);
  }
  .note {
    max-width: var(--measure);
    margin: 16px 0 0;
    font-size: 15px;
    line-height: 1.45;
    color: var(--muted);
  }
  @media (max-width: 600px) {
    .clock {
      font-size: 48px;
    }
    .chart {
      --names: 104px;
    }
  }
</style>
