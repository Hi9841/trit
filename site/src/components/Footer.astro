---
import { links } from "../lib/links";

interface Props {
  /** The day the page's sources last changed, YYYY-MM-DD. */
  updated: string;
}

const { updated } = Astro.props;

const day = new Date(`${updated}T12:00:00Z`).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<footer class="grid">
  <div class="about">
    <p>Trit is the speech engine of TDT, the dictation app. PolyForm Noncommercial 1.0.0: free for noncommercial use.</p>
    <p>Page updated <time datetime={updated}>{day}</time>.</p>
  </div>
  <nav aria-label="Footer">
    <a href={links.models}>Models</a>
    <a href={links.benchmarks}>Benchmarks</a>
    <a href={links.compare}>Compare</a>
    <a href={links.docs}>Docs</a>
    <a href={links.pricing}>Pricing</a>
    <a href={links.faq}>FAQ</a>
    <a href={links.llms}>llms.txt</a>
    <a href={links.repo}>GitHub</a>
  </nav>
</footer>

<style>
  footer {
    align-items: baseline;
    margin-top: 192px;
    padding-block: 32px 48px;
    font-size: 15px;
    color: var(--muted);
  }
  footer::before {
    content: "";
    grid-column: 1 / -1;
    margin-bottom: 32px;
    border-top: 1px solid var(--rule);
  }
  .about {
    grid-column: 1 / span 6;
  }
  p {
    margin: 0;
  }
  p + p {
    margin-top: 8px;
  }
  nav {
    grid-column: 7 / -1;
    justify-self: end;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  a {
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 4px;
    transition: text-decoration-color 150ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    a:hover {
      text-decoration-color: currentColor;
    }
  }
  @media (max-width: 900px) {
    .about,
    nav {
      grid-column: 1 / -1;
      justify-self: start;
    }
    nav {
      margin-top: 16px;
    }
  }
</style>
