---
// Parakeet Redux on Trit, from desktop/bench/benchmarks.json and trit/src/catalog.rs.
import { redux, sizeOf } from "../lib/data";

const { trit, transformers } = redux;

const stats = [
  { n: `${Math.round(trit.speed)}×`, what: "Faster than realtime on a desktop CPU" },
  { n: sizeOf("parakeet-redux"), what: "The whole model on disk, 1.58 bits a weight" },
  {
    n: `${trit.clean.toFixed(2)} %`,
    what: `Word error rate on LibriSpeech clean. The same weights in PyTorch: ${transformers.clean.toFixed(2)} %`,
  },
  { n: "0", what: "GPUs, Python installs or ONNX files needed" },
];
---

<dl class="stats" aria-label="Measured">
  {
    stats.map((s) => (
      <div>
        <dt>{s.n}</dt>
        <dd>{s.what}</dd>
      </div>
    ))
  }
</dl>

<style>
  .stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px 24px;
    margin: 0;
  }
  .stats > div {
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }
  dt {
    font-size: clamp(40px, 4vw, 56px);
    font-weight: var(--display-weight);
    line-height: 1;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  dd {
    max-width: 28ch;
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 1.45;
    color: var(--muted);
  }
</style>
