---
// Parakeet Redux on Trit against the same weights in PyTorch (Transformers),
// from bench/benchmarks.json: one row a fact.
import { megabytes, redux } from "../lib/data";

const { trit, transformers } = redux;
const x = (speed: number) => `${Math.round(speed)}×`;
const wer = (w: number) => `${w.toFixed(2)} %`;

const rows = [
  { what: "Faster than realtime", trit: x(trit.speed), them: x(transformers.speed) },
  { what: "Memory after all clips", trit: megabytes(trit.run_mb), them: megabytes(transformers.run_mb) },
  { what: "Word error rate, LibriSpeech clean", trit: wer(trit.clean), them: wer(transformers.clean) },
  { what: "Needs", trit: "No Python", them: "Python, PyTorch", words: true },
];
---

<table class="versus" aria-label="Measured: Trit against Transformers">
  <thead>
    <tr>
      <th scope="col"><span class="sr">Fact</span></th>
      <th scope="col">Trit</th>
      <th scope="col">Transformers</th>
    </tr>
  </thead>
  <tbody>
    {
      rows.map((r) => (
        <tr>
          <th scope="row">{r.what}</th>
          <td class:list={["us", { words: r.words }]}>{r.trit}</td>
          <td class:list={{ words: r.words }}>{r.them}</td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  /* A three-column ledger: Trit's column in ink and larger, the baseline muted.
     Numbers are set in mono; words stay in the text face. */
  .versus {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  thead th {
    padding: 0 0 12px 16px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: right;
    color: var(--muted);
  }
  tbody th {
    padding: 16px 16px 16px 0;
    font-weight: 400;
    line-height: 1.45;
    text-align: left;
    color: var(--muted);
    vertical-align: baseline;
  }
  td {
    padding: 16px 0 16px 16px;
    text-align: right;
    white-space: nowrap;
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    vertical-align: baseline;
  }
  td.us {
    font-size: 22px;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  td.words {
    font-family: var(--sans);
    letter-spacing: 0;
  }
  /* The narrowest phones: smaller figures, and the words may wrap. */
  @media (max-width: 400px) {
    td,
    thead th {
      padding-left: 10px;
    }
    td.us {
      font-size: 18px;
    }
    td.words:not(.us) {
      white-space: normal;
    }
  }
  @media (max-width: 360px) {
    td.words {
      white-space: normal;
    }
  }
  tbody tr {
    border-top: 1px solid var(--rule);
  }
  tbody tr:last-child {
    border-bottom: 1px solid var(--rule);
  }
</style>
