---
// Parakeet Redux on Trit against the same weights in PyTorch (Transformers),
// from desktop/bench/benchmarks.json: one row a fact.
import { megabytes, redux } from "../lib/data";

const { trit, transformers } = redux;
const x = (speed: number) => `${Math.round(speed)}×`;
const wer = (w: number) => `${w.toFixed(2)} %`;

const rows = [
  { what: "Faster than realtime", trit: x(trit.speed), them: x(transformers.speed) },
  { what: "Memory after all clips", trit: megabytes(trit.run_mb), them: megabytes(transformers.run_mb) },
  { what: "Word error rate, LibriSpeech clean", trit: wer(trit.clean), them: wer(transformers.clean) },
  { what: "Needs", trit: "No Python", them: "Python, PyTorch" },
];
---

<table class="versus" aria-label="Measured: Trit against Transformers">
  <thead>
    <tr>
      <th scope="col"><span class="sr">Fact</span></th>
      <th scope="col">Trit</th>
      <th scope="col">Transformers</th>
    </tr>
  </thead>
  <tbody>
    {
      rows.map((r) => (
        <tr>
          <th scope="row">{r.what}</th>
          <td class="us">{r.trit}</td>
          <td>{r.them}</td>
        </tr>
      ))
    }
  </tbody>
</table>
<p class="src">Same Parakeet Redux weights, same clips, same computer.</p>

<style>
  /* A three-column ledger: Trit's column in ink and larger, the baseline muted. */
  .versus {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  thead th {
    padding: 0 0 12px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: right;
    color: var(--muted);
  }
  tbody th {
    padding: 16px 16px 16px 0;
    font-weight: 400;
    line-height: 1.45;
    text-align: left;
    color: var(--muted);
    vertical-align: baseline;
  }
  td {
    padding: 16px 0 16px 16px;
    text-align: right;
    white-space: nowrap;
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    vertical-align: baseline;
  }
  td.us {
    font-size: 22px;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  tbody tr {
    border-top: 1px solid var(--rule);
  }
  tbody tr:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .src {
    margin: 16px 0 0;
    font-size: 13px;
    color: var(--muted);
  }
</style>
