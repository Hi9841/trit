---
interface Props {
  command: string;
}

const { command } = Astro.props;
---

<div class="cmd">
  <code>{command}</code>
  <button class="copy" type="button" data-copy={command}>Copy</button>
</div>

<script>
  // The label swaps through a short blur instead of jumping.
  for (const button of document.querySelectorAll<HTMLButtonElement>(".copy")) {
    const swap = (text: string) => {
      button.classList.add("swap");
      setTimeout(() => {
        button.textContent = text;
        button.classList.remove("swap");
      }, 120);
    };

    button.addEventListener("click", async () => {
      let copied = true;

      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
      } catch {
        copied = false;
      }

      swap(copied ? "Copied" : "Select it");
      setTimeout(() => swap("Copy"), 1600);
    });
  }
</script>

<style>
  .cmd {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 15px;
  }
  code {
    min-width: 0;
    overflow-x: auto;
    font: inherit;
    white-space: nowrap;
    scrollbar-width: none;
  }
  code::before {
    content: "$ ";
    color: var(--muted);
  }
  .copy {
    min-width: 72px;
    padding: 16px 0 16px 16px;
    border: 0;
    background: none;
    color: var(--muted);
    font: 500 14px/1 var(--sans);
    text-align: right;
    cursor: pointer;
    transition:
      transform 160ms var(--ease-out),
      color 150ms ease,
      opacity 120ms ease,
      filter 120ms ease;
  }
  .copy:active {
    transform: scale(0.97);
  }
  .copy.swap {
    opacity: 0;
    filter: blur(2px);
  }
  @media (hover: hover) and (pointer: fine) {
    .copy:hover {
      color: var(--ink);
    }
  }
  @media (forced-colors: active) {
    .copy {
      padding-inline: 12px;
      border: 1px solid ButtonText;
    }
  }
</style>
