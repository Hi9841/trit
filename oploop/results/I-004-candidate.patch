-/// The `count` largest values with their indices, largest first.
+/// Values per lane: one reduction of the slice as `LANES` independent ones
+/// (the rest into the first lanes), so the compiler can vectorize it. A
+/// plain fold is one chain, one value at a time.
+const LANES: usize = 16;
+
+fn lanes(values: &[f32], start: f32, op: impl Fn(f32, f32) -> f32) -> [f32; LANES] {
+    let mut acc = [start; LANES];
+    let chunks = values.chunks_exact(LANES);
+    for (a, &v) in acc.iter_mut().zip(chunks.remainder()) {
+        *a = op(*a, v);
+    }
+    for chunk in chunks {
+        for (a, &v) in acc.iter_mut().zip(chunk) {
+            *a = op(*a, v);
+        }
+    }
+    acc
+}
